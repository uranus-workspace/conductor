{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
  "timezone": "America/Sao_Paulo",
  "schedule": ["before 6am"],
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 6am"], "automerge": true },
  "packageRules": [
    {
      "description": "GitHub Actions updates are CI changes.",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Non-major updates of dev tooling: one pull request, merged once CI passes.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev dependencies",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "semantic-release 25 bundles conventional-changelog-writer 8, which cannot render preset 10. Lift this when semantic-release moves to writer 9.",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<10"
    }
  ]
}
